generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model Cita {
  ID_Cita              Int                @id(map: "PK__Cita__7C17FD16CF3DDB7E") @default(autoincrement())
  FechaCita            DateTime           @db.Date
  HoraCita             DateTime           @db.Time
  MotivoConsulta       String?            @db.VarChar(Max)
  NotasCancelacion     String?            @db.VarChar(Max)
  ID_TipoCita          Int
  ID_Direccion         Int
  ID_EstadoCita        Int
  ID_Paciente          Int
  ID_Psicologo         Int
  ID_MotivoCancelacion Int?
  Direccion            Direccion          @relation(fields: [ID_Direccion], references: [ID_Direccion], onUpdate: NoAction, map: "FK__Cita__ID_Direcci__08B54D69")
  EstadoCita           EstadoCita         @relation(fields: [ID_EstadoCita], references: [ID_EstadoCita], onUpdate: NoAction, map: "FK__Cita__ID_EstadoC__7C4F7684")
  MotivoCancelacion    MotivoCancelacion? @relation(fields: [ID_MotivoCancelacion], references: [ID_MotivoCancelacion], onDelete: NoAction, onUpdate: NoAction, map: "FK__Cita__ID_MotivoC__0C85DE4D")
  Paciente             Paciente           @relation(fields: [ID_Paciente], references: [ID_Paciente], onUpdate: NoAction, map: "FK__Cita__ID_Pacient__7D439ABD")
  Psicologo            Psicologo          @relation(fields: [ID_Psicologo], references: [ID_Psicologo], onUpdate: NoAction, map: "FK__Cita__ID_Psicolo__7E37BEF6")
  TipoDeCita           TipoDeCita         @relation(fields: [ID_TipoCita], references: [ID_TipoCita], onUpdate: NoAction, map: "FK__Cita__ID_TipoCit__7A672E12")
  Recibo               Recibo?
  Sesion               Sesion?
}

