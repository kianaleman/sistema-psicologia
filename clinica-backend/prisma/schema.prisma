  ID_Especialidad                 Int                               @id(map: "PK__Especial__5D7732D764B5D2D3") @default(autoincrement())
  Nombre_Especialidad             String?                           @db.VarChar(100)
  Psicologo_EspecialidadPsicologo Psicologo_EspecialidadPsicologo[]
}

